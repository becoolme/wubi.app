---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Playground from '../components/Playground.astro';
import Features from '../components/Features.astro';
import Pinyin from '../components/Pinyin.astro';
import Quick from '../components/Quick.astro';
import Define from '../components/Define.astro';
import Privacy from '../components/Privacy.astro';
import Keys from '../components/Keys.astro';
import Faq from '../components/Faq.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';
---
<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#FAF8F4" />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {site.analytics.domain && site.analytics.src && (
      <script is:inline defer data-domain={site.analytics.domain} src={site.analytics.src}></script>
    )}
  </head>
  <body>
    <Header />
    <main id="top">
      <Hero />
      <Playground />
      <Features />
      <Pinyin />
      <Quick />
      <Define />
      <Privacy />
      <Keys />
      <Faq />
      <Download />
    </main>
    <Footer />
  </body>
</html>
