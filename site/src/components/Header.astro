---
const links = [
  { href: '#try', text: '试一试' },
  { href: '#features', text: '功能' },
  { href: '#pinyin', text: '拼音反查' },
  { href: '#define', text: '造词' },
  { href: '#keys', text: '键位' },
  { href: '#faq', text: '常见问题' },
  { href: '#changelog', text: '更新' },
];
---
<header>
  <div class="wrap bar">
    <a href="#top" class="brand">
      <span aria-hidden="true" class="serif mark">末</span>
      <span class="serif name">末笔</span>
    </a>
    <nav aria-label="主导航">
      {links.map((link) => <a href={link.href}>{link.text}</a>)}
      <a href="#download" class="cta">下载</a>
    </nav>
  </div>
</header>

<style>
  header { border-bottom: 1px solid var(--line); }
  .bar { padding-top: 14px; padding-bottom: 14px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 32px; }
  .brand { display: flex; align-items: center; gap: 10px; min-height: 44px; }
  .brand:hover { text-decoration: none; }
  .mark { width: 32px; height: 32px; border-radius: 8px; background: var(--ac); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20px; line-height: 1; }
  .name { font-size: 20px; }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0 28px; font-size: 15px; }
  nav a { min-height: 44px; display: flex; align-items: center; }
  .cta { padding: 0 18px; border-radius: 10px; background: var(--ink); color: #fff; font-weight: 500; }
  @media (max-width: 640px) {
    .bar { flex-wrap: nowrap; }
    nav a:not(.cta) { display: none; }
  }
</style>
