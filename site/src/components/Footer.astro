---
import { site } from '../site';
---
<footer>
  <div class="wrap row">
    <span>{site.name} · {site.domain}</span>
    <span>五笔 86 码表来自 rime-wubi（LGPL-3.0），新词来自 rime-wubi86-jidian（Apache-2.0）和 THUOCL（MIT）</span>
    <a href={site.repo}>GitHub</a>
    <a href={`mailto:${site.contact}`}>{site.contact}</a>
  </div>
</footer>

<style>
  .row { padding-top: 36px; padding-bottom: 36px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; font-size: 14px; color: var(--sub); }
  a { color: inherit; }
</style>
